SCHOLARSPROUT_CONFIG_DIR=/secure/path/to/scholarsprout-config
DOMAIN_ONBOARDING_EMBEDDING_MODEL=
# Comma-separated primary,backup routes. Leave blank to use client.model_name.
DOMAIN_ONBOARDING_PLANNING_MODELS=
DOMAIN_ONBOARDING_GENERATION_MODELS=
DOMAIN_ONBOARDING_DEVELOPMENT_MODELS=
DOMAIN_ONBOARDING_LANDSCAPE_MODELS=
DOMAIN_ONBOARDING_LEARNING_PATH_MODELS=
DOMAIN_ONBOARDING_REPAIR_MODELS=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=ops@example.com
DOMAIN_ONBOARDING_JOB_TOKEN_SECRET=replace-with-at-least-32-random-bytes
DOMAIN_ONBOARDING_JOB_WORKERS=2
DOMAIN_ONBOARDING_JOB_QUEUE_SIZE=20
DOMAIN_ONBOARDING_JOB_OWNER_ACTIVE_LIMIT=2
DOMAIN_ONBOARDING_JOB_SUBMISSIONS_PER_MINUTE=10
DOMAIN_ONBOARDING_JOB_RETENTION_SECONDS=604800
DOMAIN_ONBOARDING_JOB_RECOVERY_STALE_SECONDS=900
